d == \"bag\": clf = BaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n","        elif method == \"spe\": clf = SelfPacedEnsembleClassifier(estimator=base_est, n_estimators=10, random_state=42)\n","        elif method == \"ubag\": clf = UnderBaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n","        elif method == \"obag\": clf = OverBaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n","        elif method == \"sbag\": clf = SMOTEBaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n","        else: clf = base_est\n","            \n","        # 3. Resampler\n","        if method == \"rus\": resampler = RandomUnderSampler(random_state=42)\n","        elif method == \"enn\": resampler = EditedNearestNeighbours()\n","        elif method == \"tomek\": resampler = TomekLinks()\n","        elif method == \"smote\": resampler = SMOTE(random_state=42)\n","        else: resampler = \"passthrough\"\n","\n","        # 4. Pipeline\n","        pipe = Pipeline([\n","            (\"impute\", SimpleImputer(strategy=\"median\")),\n","            (\"scale\", StandardScaler()),\n","            (\"resample\", resampler),\n","            (\"clf\", clf)\n","        ])\n","        \n","        # 5. Quick Test\n","        for tr, te in quick_cv.split(X, y):\n","            try:\n","                pipe.fit(X.iloc[tr], y.iloc[tr])\n","                proba = pipe.predict_proba(X.iloc[te])[:, 1]\n","                auprc = average_precision_score(y.iloc[te], proba)\n","                print(f\"{clf_name:<20} | {method:<10} | {'SUCCESS':<10} | {auprc:.4f}\")\n","            except Exception as e:\n","                print(f\"{clf_name:<20} | {method:<10} | ERROR      | {e}\")\n","            break"]},{"cell_type":"code","execution_count":4,"id":"1274c3c0","metadata":{"execution":{"iopub.execute_input":"2026-10-16T09:21:10.186211Z","iopub.status.busy":"2026-10-16T09:21:10.185665Z","iopub.status.idle":"2026-