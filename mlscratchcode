\n","  Credit_Approval_Classification    -0.309091\n","                             mc2    -0.418182\n","     law-school-admission-bianry          NaN\n"]}],"source":["import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","from scipy.stats import kendalltau\n","\n","# 1. Load the perfectly formatted CSV\n","df = pd.read_csv(\"final_submission_results.csv\")\n","\n","# Filter for AUPRC only, and drop any crashed runs (though we know you have 0!)\n","df_auprc = df[(df['metric'] == 'auprc') & (df['status'] == 'ok')]\n","\n","# 2. Get the average AUPRC across the 5 folds for each Dataset + Method + Classifier\n","mean_scores = df_auprc.groupby(['dataset', 'base_classifier', 'method'])['value'].mean().reset_index()\n","\n","# 3. Calculate Kendall Tau per dataset\n","datasets = mean_scores['dataset'].unique()\n","tau_results = []\n","\n","for ds in datasets:\n","    ds_data = mean_scores[mean_scores['dataset'] == ds]\n","    \n","    # Pivot to align Decision Tree and Logistic Regression side-by-side per method\n","    pivot_ds = ds_data.pivot(index='method', columns='base_classifier', values='value').dropna()\n","    \n","    # scipy.stats.kendalltau in one line, just like the professor asked\n","    tau, p_val = kendalltau(pivot_ds['decision_tree'], pivot_ds['logistic_regression'])\n","    tau_results.append({'dataset': ds, 'kendall_tau': tau})\n","\n","tau_df = pd.DataFrame(tau_results)\n","\n","# 4. Calculate Median and Interquartile Range (IQR)\n","median_tau = tau_df['kendall_tau'].median()\n","q1 = tau_df['kendall_tau'].quantile(0.25)\n","q3 = tau_df['kendall_tau'].quantile(0.75)\n","iqr = q3 - q1\n","\n","print(f\"--- KENDALL TAU STATISTICS ---\")\n","print(f\"Median Kendall Tau: {median_tau:.4f}\")\n","print(f\"IQR: {iqr:.4f} (Q1: {q1:.4f}, Q3: {q3:.4f})\")\n","print(f\"------------------------------\\n\")\n","\n","# 5. Generate Figure 1: The Kendall Tau Distribution\n","plt.figure(figsize=(8, 5))\n","sns.histplot(tau_df['kendall_tau'], bins=10, kde=True, color='#4C72B0', edgecolor='black')\n","\n","# Add vertical lines to clearly mark the Median and IQR for the paper\n","plt.axvline(median_tau, color='#C44E52', linestyle='solid', linewidth=2.5, label=f'Median: {median_tau:.2f}')\n","plt.axvline(q1, color='#55A868', linestyle='dashed', linewidth=2, label=f'Q1: {q1:.2f}')\n","plt.axvline(q3, color='#55A868', linestyle='dashed', linewidth=2, label=f'Q3: {q3:.2f}')\n","\n","plt.title('Distribution of Kendall Tau Across 20 Datasets\\n(Decision Tree vs. Logistic Regression Rankings)', fontsize=14, pad=15)\n","plt.xlabel('Kendall Tau Rank Correlation', fontsize=12)\n","plt.ylabel('Number of Datasets', fontsize=12)\n","plt.legend(loc='upper left', fontsize=11)\n","plt.grid(axis='y', alpha=0.3)\n","\n","plt.tight_layout()\n","\n","# Save the figure to your Kaggle output directory so you can download it!\n","plt.savefig('figure1_kendall_tau_distribution.png', dpi=300, bbox_inches='tight')\n","plt.show()\n","\n","# Print the raw data just in case you want to see which dataset had which Tau\n","print(tau_df.sort_values(by='kendall_tau', ascending=False).to_string(index=False))"]},{"cell_type":"code","execution_count":10,"id":"54114ca9","metadata":{"execution":{"iopub.execute_input":"2026-10-16T11:07:54.49576Z","iopub.status.busy":"2026-10-16T11:07:54.495022Z","iopub.status.idle":"2026-10-16T11:07:56.738416Z","shell.execute_reply":"2026-10-16T11:07:56.73739Z"},"papermill":{"duration":2.254219,"end_time":"2026-10-16T11:07:56.741326+00:00","exception":false,"start_time":"2026-10-16T11:07:54.487107+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["=== STATISTICAL SIGNIFICANCE TESTS (FRIEDMAN) ===\n","Decision Tree       -> Chi2: 139.96, p-value: 4.30e-25\n","Logistic Regression -> Chi2: 31.65, p-value: 4.57e-04\n","=================================================\n","\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1400x600 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 800x600 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","from scipy.stats import friedmanchisquare\n","\n","# 1. Load data and aggregate average AUPRC per (dataset, base_classifier, method)\n","df = pd.read_csv(\"final_submission_results.csv\")\n","df_auprc = df[(df['metric'] == 'auprc') & (df['status'] == 'ok')]\n","mean_scores = df_auprc.groupby(['dataset', 'base_classifier', 'method'])['value'].mean().reset_index()\n","\n","methods = sorted(mean_scores['method'].unique())\n","\n","# Helper to compute ranks per dataset (1 = best/highest AUPRC)\n","def compute_ranks_and_friedman(clf_name):\n","    clf_df = mean_scores[mean_scores['base_classifier'] == clf_name]\n","    pivot_df = clf_df.pivot(index='dataset', columns='method', values='value').dropna()\n","    \n","    # Rank methods per dataset (ascending=False -> highest AUPRC gets rank 1)\n","    ranks_df = pivot_df.rank(axis=1, ascending=False)\n","    avg_ranks = ranks_df.mean(axis=0).sort_values()\n","    \n","    # Friedman Test across datasets\n","    args = [pivot_df[m].values for m in pivot_df.columns]\n","    stat, p_value = friedmanchisquare(*args)\n","    \n","    return avg_ranks, stat, p_value, pivot_df\n","\n","dt_ranks, dt_stat, dt_p, dt_pivot = compute_ranks_and_friedman('decision_tree')\n","lr_ranks, lr_stat, lr_p, lr_pivot = compute_ranks_and_friedman('logistic_regression')\n","\n","print(\"=== STATISTICAL SIGNIFICANCE TESTS (FRIEDMAN) ===\")\n","print(f\"Decision Tree       -> Chi2: {dt_stat:.2f}, p-value: {dt_p:.2e}\")\n","print(f\"Logistic Regression -> Chi2: {lr_stat:.2f}, p-value: {lr_p:.2e}\")\n","print(\"=================================================\\n\")\n","\n","# ---------------------------------------------------------\n","# FIGURE 2: Side-by-Side Average Rank Comparison\n","# ---------------------------------------------------------\n","fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6), sharex=True)\n","\n","sns.barplot(x=dt_ranks.values, y=dt_ranks.index, ax=ax1, palette='Blues_r')\n","ax1.set_title(f'Decision Tree (Base)\\nFriedman $p$ = {dt_p:.1e}', fontsize=12, fontweight='bold')\n","ax1.set_xlabel('Average Rank (Lower is Better)', fontsize=11)\n","ax1.grid(axis='x', linestyle='--', alpha=0.5)\n","\n","sns.barplot(x=lr_ranks.values, y=lr_ranks.index, ax=ax2, palette='Oranges_r')\n","ax2.set_title(f'Logistic Regression (Base)\\nFriedman $p$ = {lr_p:.1e}', fontsize=12, fontweight='bold')\n","ax2.set_xlabel('Average Rank (Lower is Better)', fontsize=11)\n","ax2.grid(axis='x', linestyle='--', alpha=0.5)\n","\n","plt.suptitle('Figure 2: Method Rankings Comparison across 20 Datasets', fontsize=14, y=1.02)\n","plt.tight_layout()\n","plt.savefig('figure2_average_ranks_comparison.png', dpi=300, bbox_inches='tight')\n","plt.show()\n","\n","# ---------------------------------------------------------\n","# FIGURE 3: Ensemble Gain (Decision Tree vs Logistic Regression)\n","# ---------------------------------------------------------\n","# Calculate Ensemble Gain = Mean(AUPRC of Ensembles) - Base Model AUPRC\n","ensemble_methods = ['spe', 'ubag', 'obag', 'sbag', 'bag']\n","\n","def get_ensemble_gain(pivot_df):\n","    base_auprc = pivot_df['base']\n","    ens_auprc = pivot_df[ensemble_methods].mean(axis=1)\n","    return ens_auprc - base_auprc\n","\n","dt_gain = get_ensemble_gain(dt_pivot)\n","lr_gain = get_ensemble_gain(lr_pivot)\n","\n","# Combine into common dataset index\n","gain_df = pd.DataFrame({'DT_Gain': dt_gain, 'LR_Gain': lr_gain}).dropna()\n","\n","plt.figure(figsize=(8, 6))\n","sns.scatterplot(data=gain_df, x='DT_Gain', y='LR_Gain', color='#2b5c8f', s=80, edgecolor='black', alpha=0.8)\n","\n","# Add y = x reference line\n","max_val = max(gain_df['DT_Gain'].max(), gain_df['LR_Gain'].max()) * 1.1\n","min_val = min(gain_df['DT_Gain'].min(), gain_df['LR_Gain'].min()) * 1.1\n","plt.plot([min_val, max_val], [min_val, max_val], 'r--', label='Equal Gain Line (y = x)')\n","\n","plt.title('Figure 3: Ensemble Gain Over Baseline\\n(Decision Tree vs. Logistic Regression)', fontsize=13, pad=12)\n","plt.xlabel('Ensemble Gain on Decision Tree (AUPRC Boost)', fontsize=11)\n","plt.ylabel('Ensemble Gain on Logistic Regression (AUPRC Boost)', fontsize=11)\n","plt.axhline(0, color='gray', linewidth=0.8, linestyle=':')\n","plt.axvline(0, color='gray', linewidth=0.8, linestyle=':')\n","plt.legend(loc='upper left')\n","plt.grid(True, alpha=0.3)\n","\n","plt.tight_layout()\n","plt.savefig('figure3_ensemble_gain_comparison.png', dpi=300, bbox_inches='tight')\n","plt.show()"]},{"cell_type":"code","execution_count":11,"id":"96a2b556","metadata":{"execution":{"iopub.execute_input":"2026-10-16T11:07:56.761585Z","iopub.status.busy":"2026-10-16T11:07:56.76119Z","iopub.status.idle":"2026-10-16T11:07:59.750485Z","shell.execute_reply":"2026-10-16T11:07:59.749379Z"},"papermill":{"duration":3.003299,"end_time":"2026-10-16T11:07:59.754267+00:00","exception":false,"start_time":"2026-10-16T11:07:56.750968+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1200x1000 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["✅ Figure 2 successfully generated and saved as 'figure2_critical_difference_diagrams.png'!\n"]}],"source":["import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","from scipy.stats import friedmanchisquare, wilcoxon\n","from statsmodels.stats.multitest import multipletests\n","\n","# 1. Load Data\n","df = pd.read_csv(\"final_submission_results.csv\")\n","df_auprc = df[(df['metric'] == 'auprc') & (df['status'] == 'ok')]\n","mean_scores = df_auprc.groupby(['dataset', 'base_classifier', 'method'])['value'].mean().reset_index()\n","\n","# 2. Critical Difference (Demšar 2006) Plotting Function\n","def draw_cd_diagram(ax, avg_ranks, p_matrix, title, alpha=0.05):\n","    \"\"\"\n","    Plots a Demšar Critical Difference Diagram on the given Matplotlib axis.\n","    Methods connected by a horizontal bar are NOT significantly different (p >= alpha).\n","    \"\"\"\n","    sorted_methods = avg_ranks.sort_values()\n","    methods = sorted_methods.index.tolist()\n","    ranks = sorted_methods.values\n","    k = len(methods)\n","    \n","    # Configure axis line\n","    ax.set_title(title, fontsize=12, fontweight='bold', pad=25)\n","    ax.set_xlim(0.5, k + 0.5)\n","    ax.set_ylim(-1.5, 3.5)\n","    ax.spines['top'].set_position(('data', 0))\n","    ax.spines['top'].set_color('black')\n","    ax.spines['top'].set_linewidth(1.5)\n","    ax.spines['bottom'].set_visible(False)\n","    ax.spines['left'].set_visible(False)\n","    ax.spines['right'].set_visible(False)\n","    ax.yaxis.set_visible(False)\n","    \n","    # Tick marks for ranks (1 = best)\n","    ax.xaxis.set_ticks_position('top')\n","    ax.set_xticks(range(1, k + 1))\n","    ax.set_xticklabels([str(i) for i in range(1, k + 1)], fontsize=10, fontweight='bold')\n","    ax.set_xlabel('Average Rank (Lower = Better)', fontsize=11, labelpad=10)\n","    ax.xaxis.set_label_position('top')\n","    \n","    # Plot method markers & labels\n","    half = (k + 1) // 2\n","    y_top = 0.5\n","    y_bottom = -0.5\n","    \n","    for i, (method, rank) in enumerate(zip(methods, ranks)):\n","        # Alternate text positioning above/below line to prevent overlapping\n","        if i < half:\n","            y_pos = y_top + (i % 3) * 0.4\n","            va = 'bottom'\n","            y_line_end = y_pos - 0.05\n","        else:\n","            y_pos = y_bottom - ((i - half) % 3) * 0.4\n","            va = 'top'\n","            y_line_end = y_pos + 0.05\n","            \n","        ax.plot([rank, rank], [0, y_line_end], color='#444444', linestyle=':', linewidth=1)\n","        ax.plot(rank, 0, marker='o', color='#1f77b4', markersize=6)\n","        ax.text(rank, y_pos, f\"{method} ({rank:.2f})\", rotation=45, ha='left', va=va, fontsize=9, fontweight='semibold')\n","        \n","    # Find cliques of non-significantly different methods (p >= alpha) and draw horizontal bars\n","    cliques = []\n","    for i in range(k):\n","        j_max = i\n","        for j in range(i + 1, k):\n","            m1, m2 = methods[i], methods[j]\n","            # Check pairwise p-value\n","            if p_matrix.loc[m1, m2] >= alpha:\n","                j_max = j\n","        if j_max > i:\n","            cliques.append((ranks[i], ranks[j_max]))\n","            \n","    # Filter overlapping sub-cliques for a clean visual\n","    filtered_cliques = []\n","    for start, end in cliques:\n","        if not any(c_s <= start and c_e >= end and (c_s < start or c_e > end) for c_s, c_e in cliques):\n","            filtered_cliques.append((start, end))\n","            \n","    # Draw CD connecting lines\n","    bar_y = 0.15\n","    for start, end in filtered_cliques:\n","        ax.plot([start, end], [bar_y, bar_y], color='#d62728', linewidth=3.5, solid_capstyle='round')\n","        bar_y += 0.08\n","\n","# 3. Compute Ranks, Friedman Test, and Pairwise Wilcoxon-Holm p-values\n","def process_classifier(clf_name):\n","    clf_df = mean_scores[mean_scores['base_classifier'] == clf_name]\n","    pivot_df = clf_df.pivot(index='dataset', columns='method', values='value').dropna()\n","    \n","    # Ranks (1 = highest AUPRC)\n","    ranks_df = pivot_df.rank(axis=1, ascending=False)\n","    avg_ranks = ranks_df.mean(axis=0)\n","    \n","    # Friedman Test\n","    stat, p_val = friedmanchisquare(*[pivot_df[c].values for c in pivot_df.columns])\n","    \n","    # Pairwise Wilcoxon Signed-Rank Test with Holm Correction\n","    methods = pivot_df.columns.tolist()\n","    n_methods = len(methods)\n","    p_matrix = pd.DataFrame(1.0, index=methods, columns=methods)\n","    \n","    p_vals_list = []\n","    pairs = []\n","    for i in range(n_methods):\n","        for j in range(i + 1, n_methods):\n","            m1, m2 = methods[i], methods[j]\n","            _, p = wilcoxon(pivot_df[m1], pivot_df[m2])\n","            p_vals_list.append(p)\n","            pairs.append((m1, m2))\n","            \n","    # Holm-Bonferroni correction\n","    _, p_corrected, _, _ = multipletests(p_vals_list, method='holm')\n","    for (m1, m2), p_corr in zip(pairs, p_corrected):\n","        p_matrix.loc[m1, m2] = p_corr\n","        p_matrix.loc[m2, m1] = p_corr\n","        \n","    return avg_ranks, stat, p_val, p_matrix\n","\n","dt_ranks, dt_stat, dt_p, dt_p_mat = process_classifier('decision_tree')\n","lr_ranks, lr_stat, lr_p, lr_p_mat = process_classifier('logistic_regression')\n","\n","# 4. Generate Figure 2 Side-by-Side\n","fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 10))\n","\n","draw_cd_diagram(ax1, dt_ranks, dt_p_mat, f\"Decision Tree Base Learner (Friedman $\\chi^2$ = {dt_stat:.2f}, $p$ = {dt_p:.2e})\")\n","draw_cd_diagram(ax2, lr_ranks, lr_p_mat, f\"Logistic Regression Base Learner (Friedman $\\chi^2$ = {lr_stat:.2f}, $p$ = {lr_p:.2e})\")\n","\n","plt.suptitle(\"Figure 2: Critical Difference (CD) Diagrams (Wilcoxon-Holm Post-Hoc, $\\\\alpha=0.05$)\\nRed lines connect methods with no statistically significant performance difference.\", fontsize=13, y=0.98, fontweight='bold')\n","plt.tight_layout(rect=[0, 0, 1, 0.95])\n","\n","# Save high-res figure for paper\n","plt.savefig(\"figure2_critical_difference_diagrams.png\", dpi=300, bbox_inches='tight')\n","plt.show()\n","\n","print(\"✅ Figure 2 successfully generated and saved as 'figure2_critical_difference_diagrams.png'!\")"]},{"cell_type":"code","execution_count":12,"id":"e39a85d8","metadata":{"execution":{"iopub.execute_input":"2026-10-16T11:07:59.778266Z","iopub.status.busy":"2026-10-16T11:07:59.777916Z","iopub.status.idle":"2026-10-16T11:07:59.790498Z","shell.execute_reply":"2026-10-16T11:07:59.789