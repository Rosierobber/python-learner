}\")\n","        continue\n","        \n","    n_samples, n_features = X.shape\n","    counts = y.value_counts()\n","    ir = round(counts[0] / counts[1], 2)\n","\n","    for clf_name in classifiers_to_run:\n","        for method in methods_to_run:\n","            \n","            # Skip if this specific block is already done (checks fold 24)\n","            if f\"{dataset_name}_{method}_{clf_name}_24_auprc\" in completed_runs:\n","                continue\n","            \n","            # Base Estimators\n","            base_dt = DecisionTreeClassifier(random_state=42)\n","            base_lr = LogisticRegression(max_iter=1000, random_state=42)\n","            base_est = base_dt if clf_name == \"decision_tree\" else base_lr\n","            \n","            # Classifier Setup\n","            if method == \"cost\":\n","                clf = DecisionTreeClassifier(class_weight='balanced', random_state=42) if clf_name == \"decision_tree\" else LogisticRegression(class_weight='balanced', max_iter=1000, random_state=42)\n","            elif method == \"bag\": clf = BaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n","            elif method == \"spe\": clf = SelfPacedEnsembleClassifier(estimator=base_est, n_estimators=10, random_state=42)\n","            elif method == \"ubag\": clf = UnderBaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n","            elif method == \"obag\": clf = OverBaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n","            elif method == \"sbag\": clf = SMOTEBaggingClassifier(estimator=base_est, n_estimators=10, random_state=42)\n","            else: clf = base_est\n","                \n","            # Resampler Setup\n","            if method == \"rus\": resampler = RandomUnderSampler(random_state=42)\n","            elif method == \"enn\": resampler = EditedNearestNeighbours()\n","            elif method == \"tomek\": resampler = TomekLinks()\n","            elif method 